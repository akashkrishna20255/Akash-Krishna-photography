{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gallery-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2024-01-01",
  "assets": {
    "directory": "./dist"
  },
  "kv_namespaces": [
    {
      "binding": "PHOTO_KV",
      "id": "<your-kv-namespace-id>"
    }
  ]
}
